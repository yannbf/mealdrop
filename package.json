{
  "name": "course-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "build-all": "yarn build && yarn build-storybook",
    "build-storybook": "storybook build --output-dir build/storybook",
    "build-storybook:test": "storybook build --output-dir build/storybook --test",
    "chromatic": "chromatic --project-token $CHROMATIC_PROJECT_TOKEN --exit-zero-on-changes --only-changed",
    "lint": "oxlint --fix . && oxfmt .",
    "lint:check": "oxlint . && oxfmt --check .",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "serve": "vite preview",
    "start": "vite",
    "check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test-storybook": "test-storybook",
    "test-storybook:ci": "concurrently --kill-others --success first --names \"SB,TEST\" --prefix-colors \"magenta,blue\" \"yarn build-storybook:test && npx serve build/storybook --listen 6006 --no-request-logging\" \"wait-on tcp:6006 && yarn test-storybook\"",
    "test-storybook:json": "test-storybook --index-json",
    "test-storybook:json:ci": "concurrently --kill-others --success first --names \"SB,TEST\" --prefix-colors \"magenta,blue\" \"yarn build-storybook:test && npx serve build/storybook --listen 6006 --no-request-logging\" \"wait-on tcp:6006 && SKIP_SNAPSHOTS=true yarn test-storybook:json\"",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt ."
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{html,md,json}": "oxfmt"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "resolutions": {
    "@use-it/event-listener@npm:^0.1.2": "patch:@use-it/event-listener@npm%3A0.1.7#~/.yarn/patches/@use-it-event-listener-npm-0.1.7-56ef42a654.patch"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.3",
    "@reduxjs/toolkit": "^2.6.0",
    "axios": "^1.8.1",
    "embla-carousel-react": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-hooks-helper": "^1.6.0",
    "react-loading-skeleton": "^3.5.0",
    "react-lottie-player": "^2.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.2.0",
    "react-transition-group": "^4.4.5",
    "styled-components": "^6.1.15",
    "stylis": "^4.3.6",
    "typescript": "^5.7.3",
    "use-dark-mode": "^2.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-coverage": "^3.0.2",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.3",
    "@storybook/react-vite": "^10.5.3",
    "@storybook/test-runner": "^0.24.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.17.19",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-hooks-helper": "^1.6.6",
    "@types/react-redux": "^7.1.34",
    "@types/react-transition-group": "^4.4.12",
    "@types/stylis": "^4.2.7",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "babel-loader": "8.4.1",
    "babel-plugin-istanbul": "^6.1.1",
    "babel-plugin-open-source": "^1.3.4",
    "c8": "^7.14.0",
    "chromatic": "^11.26.1",
    "concurrently": "^9.1.2",
    "eslint-plugin-storybook": "^10.5.3",
    "happy-dom": "^17.1.8",
    "husky": "^9.1.7",
    "istanbul": "^0.4.5",
    "jest-junit": "^16.0.0",
    "lint-staged": "^15.4.3",
    "msw": "^2.7.3",
    "msw-storybook-addon": "^2.0.7",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "playwright": "^1.50.1",
    "react-is": "^19.0.0",
    "react-test-renderer": "^19.0.0",
    "storybook": "^10.5.3",
    "storybook-addon-test-codegen": "^3.0.4",
    "vite": "^8.1.4",
    "vitest": "^4.1.0",
    "wait-on": "^8.0.2"
  },
  "packageManager": "yarn@4.2.1",
  "msw": {
    "workerDirectory": "public"
  }
}
