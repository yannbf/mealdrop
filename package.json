{
  "name": "course-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "build-all": "yarn build",
    "lint": "oxlint --fix . && oxfmt .",
    "lint:check": "oxlint . && oxfmt --check .",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "serve": "vite preview",
    "start": "vite",
    "check": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt ."
  },
  "lint-staged": {
    "!(mockServiceWorker).{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{html,md,json}": "oxfmt"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "resolutions": {
    "@use-it/event-listener@npm:^0.1.2": "patch:@use-it/event-listener@npm%3A0.1.7#~/.yarn/patches/@use-it-event-listener-npm-0.1.7-56ef42a654.patch"
  },
  "dependencies": {
    "@base-ui/react": "https://pkg.pr.new/storybook-tmp/base-ui/@base-ui/react@85313eccf",
    "@droppy/design-system": "https://pkg.pr.new/yannbf/droppy-ds/@droppy/design-system@1fba4ce",
    "@hookform/resolvers": "^5.5.7",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.18.1",
    "embla-carousel-react": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-hooks-helper": "^1.6.0",
    "react-loading-skeleton": "^3.5.0",
    "react-lottie-player": "^2.1.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2",
    "react-transition-group": "^4.4.5",
    "styled-components": "^6.4.4",
    "stylis": "^4.4.0",
    "typescript": "^7.0.2",
    "use-dark-mode": "^2.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-hooks-helper": "^1.6.6",
    "@types/react-redux": "^7.1.34",
    "@types/react-transition-group": "^4.4.12",
    "@types/stylis": "^4.2.7",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "jest-junit": "^17.0.0",
    "lint-staged": "^17.2.0",
    "msw": "^2.15.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "playwright": "^1.62.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.1"
  },
  "packageManager": "yarn@4.18.0",
  "msw": {
    "workerDirectory": "public"
  }
}
